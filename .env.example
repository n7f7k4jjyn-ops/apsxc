# URL pública usada nos links canônicos e prévias dos formulários.
PUBLIC_BASE_URL=https://central.verdantcwb.com

# Por padrão, os cabeçalhos X-Forwarded-* não são confiáveis.
# Configure o número de proxies reversos confiáveis somente após verificar a hospedagem.
TRUST_PROXY_HOPS=0

# Banco opcional. Com todos os campos vazios, o servidor usa arquivos JSON em storage/.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Contas iniciais em JSON. Não coloque senhas ou hashes reais neste arquivo versionado.
VERDANT_USERS_JSON=[]
# Username da conta administradora inicial, se informado; deve corresponder a uma conta ativa.
VERDANT_ADMIN_USERNAME=
# Chave AES-256-GCM (32 bytes em base64 ou 64 caracteres hexadecimais) para segredos de integrações.
VERDANT_INTEGRATION_ENCRYPTION_KEY=
# Arquivo JSON de configuração das integrações; com MySQL configurado, usa a tabela verdant_app_data.
VERDANT_INTEGRATIONS_FILE=

# Chave pública usada apenas se o modo Clerk for habilitado.
VITE_CLERK_PUBLISHABLE_KEY=
